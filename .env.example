# Directus admin token for scripts/* — value is the full Authorization
# header string. Create a static token in Directus (user → Access Tokens),
# then copy this file to .env and fill in real values. NEVER commit .env.
BOOKING_ADMIN_TOKEN=Bearer <directus-static-token>

# Password for the throwaway test accounts used by scripts/test-*.mjs
BOOKING_TEST_PASSWORD=<test-account-password>
